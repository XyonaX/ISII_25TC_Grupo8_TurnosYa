{
    "openapi": "3.0.0",
    "info": {
        "title": "TurnosYa-API",
        "version": "1.0.0",
        "description": "Documentación de TurnosYa API usando Swagger"
    },
    "tags": [
        {
            "name": "Users",
            "description": "Operaciones relacionadas con los usuarios"
        },
        {
            "name": "Turnos",
            "description": "Operaciones relacionadas con los turnos"
        }
    ],
    "paths": {
        "/api": {
            "get": {
                "summary": "Ruta principal",
                "responses": {
                    "200": {
                        "description": "Respuesta exitosa"
                    }
                }
            }
        },
        "/api/users": {
            "get": {
                "tags": ["Users"],
                "summary": "Obtener todos los usuarios",
                "responses": {
                    "200": {
                        "description": "Lista de usuarios"
                    }
                }
            }
        },
        "/api/users/dni/{dni}": {
            "get": {
                "tags": ["Users"],
                "summary": "Obtener usuario por DNI",
                "parameters": [
                    {
                        "name": "dni",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario encontrado"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                }
            }
        },
        "/api/users/{id}": {
            "get": {
                "tags": ["Users"],
                "summary": "Obtener usuario por ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario encontrado"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                }
            },
            "put": {
                "tags": ["Users"],
                "summary": "Actualizar usuario",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Usuario actualizado"
                    }
                }
            },
            "delete": {
                "tags": ["Users"],
                "summary": "Eliminar usuario",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario eliminado"
                    }
                }
            }
        },
        "/api/users/create": {
            "post": {
                "tags": ["Users"],
                "summary": "Crear un nuevo usuario",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario creado"
                    }
                }
            }
        },
        "/api/turnos": {
            "get": {
                "tags": ["Turnos"],
                "summary": "Obtener todos los turnos disponibles",
                "responses": {
                    "200": {
                        "description": "Lista de turnos disponibles"
                    }
                }
            },
            "post": {
                "tags": ["Turnos"],
                "summary": "Crear un nuevo turno (solo médico)",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Turno"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Turno creado"
                    }
                }
            }
        },
        "/api/turnos/{id}": {
            "get": {
                "tags": ["Turnos"],
                "summary": "Obtener turno por ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": { "description": "Turno encontrado" },
                    "404": { "description": "Turno no encontrado" }
                }
            },
            "put": {
                "tags": ["Turnos"],
                "summary": "Actualizar turno (solo médico)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Turno"
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Turno actualizado" }
                }
            },
            "delete": {
                "tags": ["Turnos"],
                "summary": "Eliminar turno (solo médico)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": { "description": "Turno eliminado" }
                }
            }
        },
        "/api/turnos/{id}/agendar": {
            "post": {
                "tags": ["Turnos"],
                "summary": "Agendar turno (solo paciente)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "motivo_turno": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Turno agendado" }
                }
            }
        },
        "/api/turnos/{id}/motivo": {
            "put": {
                "tags": ["Turnos"],
                "summary": "Editar motivo del turno (solo paciente)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "motivo_turno": { "type": "string" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": { "description": "Motivo actualizado" }
                }
            }
        },
        "/api/turnos/{id}/cancelar": {
            "delete": {
                "tags": ["Turnos"],
                "summary": "Cancelar turno (solo paciente)",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": { "description": "Turno cancelado" }
                }
            }
        },
        "/api/turnos/medico/{id}": {
            "get": {
                "tags": ["Turnos"],
                "summary": "Obtener turnos disponibles de un médico",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": { "description": "Lista de turnos del médico" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "security": [
            {
                "bearerAuth": []
            }
        ],
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "dni_usuario": { "type": "string" },
                    "nombre_usuario": { "type": "string" },
                    "apellido_usuario": { "type": "string" },
                    "fecha_nac_usuario": { "type": "string", "format": "date" },
                    "celular_usuario": { "type": "string" },
                    "email_usuario": { "type": "string" },
                    "clave_usuario": { "type": "string" },
                    "calle_usuario": { "type": "string" },
                    "num_usuario": { "type": "string" },
                    "dpto_usuario": { "type": "string", "nullable": true },
                    "cod_postal": { "type": "string" },
                    "id_ciudad": { "type": "string" },
                    "id_estado_usuario": { "type": "string" },
                    "tipo_usuario": {
                        "type": "string",
                        "enum": ["paciente", "medico"]
                    }
                },
                "required": [
                    "dni_usuario",
                    "nombre_usuario",
                    "apellido_usuario",
                    "fecha_nac_usuario",
                    "celular_usuario",
                    "email_usuario",
                    "clave_usuario",
                    "calle_usuario",
                    "num_usuario",
                    "cod_postal",
                    "id_ciudad",
                    "id_estado_usuario",
                    "tipo_usuario"
                ]
            },
            "Turno": {
                "type": "object",
                "properties": {
                    "_id": { "type": "string", "description": "ID del turno" },
                    "id_medico": {
                        "type": "string",
                        "description": "ID del médico"
                    },
                    "id_paciente": {
                        "type": "string",
                        "description": "ID del paciente",
                        "nullable": true
                    },
                    "fecha_turno": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Fecha"
                    },
                    "hora_turno": {
                        "type": "string",
                        "format": "time",
                        "description": "Hora del turno"
                    },
                    "motivo_turno": {
                        "type": "string",
                        "description": "Motivo del turno",
                        "nullable": true
                    },
                    "estado_turno": {
                        "type": "string",
                        "description": "Estado del turno"
                    }
                },
                "required": ["id_medico", "fecha_turno", "hora_turno"]
            }
        }
    }
}
